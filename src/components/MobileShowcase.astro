---
import Pic from './Pic.astro';

const iphoneStrip = [
  { n: 'iphone-aurora-portfolio', t: 'Portfolio', alt: 'ABCT V2 on iPhone: Portfolio screen in the Aurora theme with a hero net worth, a labelled chart, summary cards and an allocation donut (Demo data).' },
  { n: 'iphone-aurora-assets', t: 'Assets', alt: 'ABCT V2 on iPhone: Assets list with price, value, 24 hour change and share of portfolio for each holding (Demo data).' },
  { n: 'iphone-aurora-asset', t: 'Asset detail', alt: 'ABCT V2 on iPhone: ADA asset detail with live price, price chart and holding value (Demo data).' },
  { n: 'iphone-aurora-performance', t: 'Performance', alt: 'ABCT V2 on iPhone: Performance screen with total profit and loss, realized and unrealized gains, and a net worth chart (Demo data).' },
  { n: 'iphone-aurora-defi', t: 'DeFi & Staking', alt: 'ABCT V2 on iPhone: DeFi and Staking screen grouping positions into stake delegation, liquid staking, lending, liquidity pools and farming (Demo data).' },
  { n: 'iphone-aurora-nfts', t: 'NFTs', alt: 'ABCT V2 on iPhone: NFT wall with a uniform grid of tiles and collection filters (Demo data).' },
  { n: 'iphone-aurora-transactions', t: 'Transactions', alt: 'ABCT V2 on iPhone: Transactions list with sent and received filters and a 7 day to 1 year window selector (Demo data).' },
  { n: 'iphone-aurora-settings', t: 'Settings and Theme', alt: 'ABCT V2 on iPhone: Settings screen with a Theme picker offering Aurora, Cypherpunk and Light (Demo data).' },
];

const themes = [
  { n: 'iphone-aurora-portfolio', t: 'Aurora', d: 'The default. Near-black with a warm dusk glow.', alt: 'ABCT V2 Portfolio in the Aurora theme: dark glass cards with an amber and coral glow (Demo data).' },
  { n: 'iphone-cypherpunk-portfolio', t: 'Cypherpunk', d: 'Navy and indigo with electric blue and violet neon lines.', alt: 'ABCT V2 Portfolio in the Cypherpunk theme: navy and indigo with violet neon chart lines (Demo data).' },
  { n: 'iphone-light-portfolio', t: 'Light', d: 'White cards on a soft ground, with coloured line halos.', alt: 'ABCT V2 Portfolio in the Light theme: white cards with soft shadows and a violet chart line (Demo data).' },
];

const features = [
  { t: 'Portfolio at a glance', d: 'Hero net worth, a labelled chart you can scrub, and a plain-language line such as "Up $2,310 today, led by ADA".' },
  { t: 'Summary cards', d: 'Change, Staking, Exchanges and Movers (top gainer and biggest loser). The period follows the chart range you pick.' },
  { t: 'Assets with "Where it lives"', d: 'Holdings with 7-day sparklines. Open an asset to see its price chart and which wallets and exchanges hold it.' },
  { t: 'DeFi & Staking', d: 'Positions grouped by type, with logos, pending rewards and APY where your server provides them.' },
  { t: 'NFT wall', d: 'A uniform tile grid with collection filters and floor price.' },
  { t: 'Exchanges', d: 'Connected exchange balances alongside your on-chain wallets.' },
  { t: 'Performance', d: 'All-time P&L, realized and unrealized, net worth chart with high, low and max drawdown, top gainers and losers, and a cost-basis drill-down.' },
  { t: 'Transactions', d: 'Sent and received history across chains with a 7D / 30D / 90D / 1Y window.' },
  { t: 'Cardano-first coverage', d: 'Native Cardano tokens appear per wallet, with token logos.' },
  { t: 'Home & Lock Screen widgets', d: 'Small, medium and large widgets plus Lock Screen widgets, in your chosen theme.' },
  { t: 'Apple Watch app', d: 'Glanceable value, 24h change, a sparkline and movers, with complications for your watch face.' },
  { t: 'Stats link-out', d: 'One tap from an asset to a market data site (CoinGecko or CoinMarketCap). Only the coin id or ticker is sent.' },
];

const watchGlances = [
  { n: 'watch-aurora-glance', t: 'Aurora', alt: 'ABCT V2 on Apple Watch in the Aurora theme: total value, 24 hour change, a sparkline and a Demo tag.' },
  { n: 'watch-cypherpunk-glance', t: 'Cypherpunk', alt: 'ABCT V2 on Apple Watch in the Cypherpunk theme with an indigo background.' },
  { n: 'watch-light-glance', t: 'Light', alt: 'ABCT V2 on Apple Watch in the Light theme, which keeps an indigo and cyan palette on a dark ground.' },
  { n: 'watch-privacy', t: 'Privacy', alt: 'ABCT V2 on Apple Watch with amounts masked as dots while the percentage change stays visible.' },
  { n: 'watch-stale', t: 'Stale data', alt: 'ABCT V2 on Apple Watch with dimmed values and a clock icon showing the data is over an hour old.' },
];
---

<section class="section v2" id="v2" aria-labelledby="v2-title">
  <div class="container">
    <div class="v2-intro">
      <span class="v2-badge">Coming soon</span>
      <h2 class="section-title v2-title" id="v2-title">
        ABCT V2 for <span class="accent">iPhone, iPad &amp; Apple Watch</span>
      </h2>
      <p class="section-subtitle">
        A new native app, built for your self-hosted ABCT. Upcoming, with layouts for iPhone, iPad, a foldable iPhone Duo and Apple Watch. Not yet available to download.
      </p>
      <ul class="v2-pills" aria-label="Supported devices">
        <li>iPhone</li><li>iPad</li><li>Foldable (Duo)</li><li>Apple Watch</li>
      </ul>
    </div>

    <div class="hero-devices">
      <div class="hd hd-ipad frame frame-ipad">
        <Pic name="ipadpro-aurora-assets" sizes="(max-width: 768px) 90vw, 560px" eager
          alt="ABCT V2 on iPad Pro: Assets with the list on the left, an ADA price chart and holding in the middle, and a Where it lives donut with wallets (Demo data)." />
      </div>
      <div class="hd hd-phone frame frame-phone">
        <Pic name="iphone-aurora-portfolio" sizes="(max-width: 768px) 55vw, 300px" eager
          alt="ABCT V2 on iPhone Pro: Portfolio with a net worth of $168,199, a labelled chart and summary cards (Demo data)." />
      </div>
      <div class="hd hd-watch frame frame-watch">
        <Pic name="watch-aurora-glance" sizes="(max-width: 768px) 30vw, 170px" eager
          alt="ABCT V2 on Apple Watch: total value, 24 hour change and a sparkline (Demo data)." />
      </div>
    </div>
    <p class="demo-note">All screenshots show the built-in <strong>Demo</strong> profile with sample data only. Nothing here is a real portfolio.</p>

    <!-- iPhone -->
    <div class="block" id="v2-iphone">
      <h3 class="block-title">iPhone</h3>
      <p class="block-sub">Every section of your portfolio, in one tab bar.</p>
      <ul class="strip" role="list">
        {iphoneStrip.map((s) => (
          <li class="shot">
            <div class="frame frame-phone"><Pic name={s.n} sizes="(max-width: 768px) 62vw, 240px" alt={s.alt} /></div>
            <p class="cap">{s.t}</p>
          </li>
        ))}
      </ul>
    </div>

    <!-- Summary cards / movers -->
    <div class="block split">
      <div class="split-text">
        <h3 class="block-title left">Summary cards and Movers</h3>
        <p>Change, Staking, Exchanges and Movers sit under the chart. At launch they show the 24h change. Tap a chart range such as 1W and they follow it, including the top gainer and biggest loser for that period.</p>
        <ul class="checks">
          <li>Plain-language summary line</li>
          <li>Press and drag on the chart to scrub it</li>
          <li>Dust under $10 is ignored in Movers</li>
        </ul>
      </div>
      <div class="split-media pair">
        <div class="frame frame-phone"><Pic name="iphone-aurora-portfolio" sizes="(max-width: 768px) 42vw, 260px" alt="Portfolio with the 24 hour Change and Movers cards (Demo data)." /></div>
        <div class="frame frame-phone"><Pic name="iphone-aurora-portfolio-1w" sizes="(max-width: 768px) 42vw, 260px" alt="The same Portfolio after tapping 1W: the Change card reads 1W change and Movers shows a 1 week gainer (Demo data)." /></div>
      </div>
    </div>

    <!-- iPad -->
    <div class="block" id="v2-ipad">
      <h3 class="block-title">iPad</h3>
      <p class="block-sub">Sidebar-adaptable tabs, two-pane lists and a wide Assets layout that shows where each asset lives.</p>
      <div class="ipad-grid">
        <figure class="shot wide">
          <div class="frame frame-ipad"><Pic name="ipadpro-aurora-assets" sizes="(max-width: 900px) 92vw, 560px" alt="iPad Pro 13-inch: Assets list, ADA price chart and a Where it lives donut with wallet and exchange breakdown (Demo data)." /></div>
          <figcaption class="cap">iPad Pro 13-inch: Assets and "Where it lives"</figcaption>
        </figure>
        <figure class="shot wide">
          <div class="frame frame-ipad"><Pic name="ipadpro-aurora-performance" sizes="(max-width: 900px) 92vw, 560px" alt="iPad Pro 13-inch: Performance with a P&amp;L by asset table next to the overview, net worth chart and monthly realized bars (Demo data)." /></div>
          <figcaption class="cap">iPad Pro 13-inch: Performance</figcaption>
        </figure>
        <figure class="shot wide">
          <div class="frame frame-ipad"><Pic name="ipadpro-aurora-defi" sizes="(max-width: 900px) 92vw, 560px" alt="iPad Pro 13-inch: DeFi and Staking with a position list and an overview panel (Demo data)." /></div>
          <figcaption class="cap">iPad Pro 13-inch: DeFi &amp; Staking</figcaption>
        </figure>
        <figure class="shot wide">
          <div class="frame frame-ipad"><Pic name="ipadpro-light-assets" sizes="(max-width: 900px) 92vw, 560px" alt="iPad Pro 13-inch in the Light theme: Assets with chart and Where it lives (Demo data)." /></div>
          <figcaption class="cap">iPad Pro 13-inch: Light theme</figcaption>
        </figure>
        <figure class="shot">
          <div class="frame frame-ipad"><Pic name="ipadmini-aurora-assets" sizes="(max-width: 900px) 92vw, 380px" alt="iPad mini: Assets in a two-column layout with the asset detail on the right (Demo data)." /></div>
          <figcaption class="cap">iPad mini: Assets</figcaption>
        </figure>
        <figure class="shot">
          <div class="frame frame-ipad"><Pic name="ipadmini-aurora-nfts" sizes="(max-width: 900px) 92vw, 380px" alt="iPad mini: NFT wall with collection summary tiles and a three-column grid (Demo data)." /></div>
          <figcaption class="cap">iPad mini: NFTs</figcaption>
        </figure>
      </div>
    </div>

    <!-- Duo -->
    <div class="block" id="v2-duo">
      <h3 class="block-title">Foldable iPhone Duo</h3>
      <p class="block-sub">A layout that adapts to width: master-detail when open, a single pane when folded, with the system vertical tab bar.</p>
      <div class="duo-grid">
        <figure class="shot">
          <div class="frame frame-duo"><Pic name="duo-open-dashboard" sizes="(max-width: 900px) 92vw, 640px" alt="iPhone Duo open (inner display): Portfolio with the vertical tab bar on the right edge (Demo data)." /></div>
          <figcaption class="cap">Open (inner display)</figcaption>
        </figure>
        <figure class="shot">
          <div class="frame frame-phone"><Pic name="duo-closed-dashboard" sizes="(max-width: 900px) 55vw, 260px" alt="iPhone Duo folded (outer display): Portfolio filling the screen with the vertical tab bar (Demo data)." /></div>
          <figcaption class="cap">Folded (outer display)</figcaption>
        </figure>
      </div>
      <p class="fine">Duo screenshots come from the iPhone Duo simulator and an earlier build, so summary cards differ slightly from the latest iPhone screens.</p>
    </div>

    <!-- Themes -->
    <div class="block" id="v2-themes">
      <h3 class="block-title">Three themes</h3>
      <p class="block-sub">Pick Aurora, Cypherpunk or Light in Settings, or match the system. Widgets and the watch follow your choice.</p>
      <ul class="strip strip-center" role="list">
        {themes.map((s) => (
          <li class="shot">
            <div class="frame frame-phone"><Pic name={s.n} sizes="(max-width: 768px) 62vw, 260px" alt={s.alt} /></div>
            <p class="cap"><strong>{s.t}</strong><br /><span class="cap-sub">{s.d}</span></p>
          </li>
        ))}
      </ul>
    </div>

    <!-- Apple Watch -->
    <div class="block" id="v2-watch">
      <h3 class="block-title">Apple Watch</h3>
      <p class="block-sub">A glanceable companion. The watch never signs in to your server: your iPhone sends it a small snapshot.</p>
      <ul class="strip strip-center" role="list">
        {watchGlances.map((s) => (
          <li class="shot watch-shot">
            <div class="frame frame-watch"><Pic name={s.n} sizes="(max-width: 768px) 38vw, 190px" alt={s.alt} /></div>
            <p class="cap">{s.t}</p>
          </li>
        ))}
      </ul>
      <h4 class="sub-title">Complications</h4>
      <ul class="strip strip-center" role="list">
        <li class="shot watch-shot">
          <div class="frame frame-watch"><Pic name="watch-comps" sizes="(max-width: 768px) 42vw, 210px" alt="Apple Watch complications: a circular 24 hour gauge, a rectangular value and change tile, and an inline text complication (Demo data)." /></div>
          <p class="cap">Circular, rectangular and inline</p>
        </li>
        <li class="shot watch-shot">
          <div class="frame frame-watch"><Pic name="watch-comps-privacy" sizes="(max-width: 768px) 42vw, 210px" alt="The same complications with the dollar amounts masked as dots and only the percentage visible." /></div>
          <p class="cap">Masked in privacy mode</p>
        </li>
      </ul>
    </div>

    <!-- Widgets -->
    <div class="block" id="v2-widgets">
      <h3 class="block-title">Home Screen widgets</h3>
      <p class="block-sub">Small, medium and large widgets in the Aurora, Cypherpunk or Light style, plus Lock Screen widgets. The widget itself has no network access.</p>
      <ul class="strip strip-center" role="list">
        <li class="shot"><div class="frame frame-card"><Pic name="iphone-aurora-widget" sizes="(max-width: 768px) 62vw, 260px" alt="Home Screen widgets in the Aurora style: small, medium and large net worth widgets with a sparkline and top holdings (Demo data)." /></div><p class="cap">Aurora</p></li>
        <li class="shot"><div class="frame frame-card"><Pic name="iphone-cypherpunk-widget" sizes="(max-width: 768px) 62vw, 260px" alt="Home Screen widgets in the Cypherpunk style (Demo data)." /></div><p class="cap">Cypherpunk</p></li>
        <li class="shot"><div class="frame frame-card"><Pic name="iphone-light-widget" sizes="(max-width: 768px) 62vw, 260px" alt="Home Screen widgets in the Light style (Demo data)." /></div><p class="cap">Light</p></li>
      </ul>
    </div>

    <!-- Privacy -->
    <div class="block split reverse" id="v2-privacy">
      <div class="split-media pair">
        <div class="frame frame-phone"><Pic name="iphone-aurora-privacy" sizes="(max-width: 768px) 42vw, 260px" alt="Portfolio in privacy mode: the net worth, card amounts and chart labels are masked as dots (Demo data)." /></div>
        <div class="frame frame-phone"><Pic name="iphone-cypherpunk-privacy" sizes="(max-width: 768px) 42vw, 260px" alt="Privacy mode in the Cypherpunk theme with all dollar amounts masked (Demo data)." /></div>
      </div>
      <div class="split-text">
        <h3 class="block-title left">Privacy by design</h3>
        <p>One tap masks net worth, quantities, KPI amounts and chart labels. Widgets and the watch follow the same rule and are sent masked, so amounts never reach them.</p>
        <ul class="checks">
          <li>Privacy mode and an optional Face ID lock</li>
          <li>Sign-in secrets are kept only in the iOS Keychain</li>
          <li>Widgets and the watch hold no tokens, no server address and no wallet addresses</li>
          <li>A built-in Demo profile that runs on sample data with no network calls</li>
        </ul>
      </div>
    </div>

    <!-- Feature grid -->
    <div class="block" id="v2-features">
      <h3 class="block-title">What is in V2</h3>
      <p class="block-sub">Everything below is in the current build of the app.</p>
      <ul class="feature-grid" role="list">
        {features.map((f) => (
          <li class="card v2-card">
            <h4>{f.t}</h4>
            <p>{f.d}</p>
          </li>
        ))}
      </ul>
      <p class="fine center">ABCT V2 is upcoming. It is not on the App Store yet, and there is no release date or pricing to announce.</p>
    </div>
  </div>
</section>

<style>
  .v2 {
    background:
      radial-gradient(ellipse at 50% 0%, rgba(120, 80, 220, 0.18) 0%, transparent 55%),
      var(--bg-primary);
    overflow-x: clip;
  }
  .accent { color: var(--accent); }
  .v2-intro { text-align: center; }
  .v2-badge {
    display: inline-block;
    padding: 6px 16px;
    border-radius: 100px;
    background: rgba(255, 176, 64, 0.12);
    border: 1px solid rgba(255, 176, 64, 0.4);
    color: #ffc266;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .v2-title { max-width: 820px; margin-left: auto; margin-right: auto; }
  .v2-pills {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-bottom: 48px;
  }
  .v2-pills li {
    padding: 6px 16px;
    border: 1px solid var(--border);
    border-radius: 100px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  /* Device frames drawn in CSS (no vendor artwork) */
  .frame {
    background: #07070d;
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.5), 0 0 0 3px #11111a;
    overflow: hidden;
    line-height: 0;
  }
  .frame img { width: 100%; height: auto; }
  .frame-phone { border-radius: 34px; padding: 6px; }
  .frame-phone img { border-radius: 28px; }
  .frame-ipad { border-radius: 22px; padding: 8px; }
  .frame-ipad img { border-radius: 14px; }
  .frame-duo { border-radius: 26px; padding: 7px; }
  .frame-duo img { border-radius: 19px; }
  .frame-watch { border-radius: 44px; padding: 7px; }
  .frame-watch img { border-radius: 37px; }
  .frame-card { border-radius: 24px; padding: 6px; }
  .frame-card img { border-radius: 18px; }

  /* Hero composition */
  .hero-devices {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: 0;
    max-width: 920px;
    margin: 0 auto 16px;
    min-height: 0;
  }
  .hd-ipad { width: 62%; transform: translateX(8%); }
  .hd-phone { width: 30%; margin-left: -4%; z-index: 2; }
  .hd-watch { width: 17%; margin-left: -6%; z-index: 3; }
  .demo-note {
    text-align: center;
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 20px auto 0;
    max-width: 560px;
  }

  .block { margin-top: 110px; }
  .block-title {
    font-size: 1.9rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 8px;
  }
  .block-title.left { text-align: left; }
  .block-sub {
    text-align: center;
    color: var(--text-secondary);
    max-width: 620px;
    margin: 0 auto 36px;
  }
  .sub-title {
    text-align: center;
    margin: 40px 0 16px;
    font-size: 1.1rem;
    color: var(--text-secondary);
  }

  .strip {
    list-style: none;
    display: flex;
    gap: 28px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 12px 4px 24px;
    scrollbar-width: thin;
  }
  @media (min-width: 901px) {
    .strip { flex-wrap: wrap; justify-content: center; overflow-x: visible; }
  }
  .strip-center { justify-content: center; flex-wrap: wrap; overflow-x: visible; }
  .strip .shot { flex: 0 0 240px; scroll-snap-align: center; }
  .strip-center .shot { flex: 0 0 min(260px, 100%); }
  .strip-center .watch-shot { flex-basis: 190px; }
  .shot { margin: 0; }
  .cap {
    margin-top: 14px;
    text-align: center;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-secondary);
    line-height: 1.4;
  }
  .cap-sub { font-weight: 400; color: var(--text-muted); font-size: 0.85rem; }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .split.reverse .split-media { order: -1; }
  .split-text p { color: var(--text-secondary); margin-bottom: 16px; }
  .checks { list-style: none; display: grid; gap: 10px; }
  .checks li { position: relative; padding-left: 28px; color: var(--text-primary); }
  .checks li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 12px;
    height: 7px;
    border-left: 2px solid var(--accent);
    border-bottom: 2px solid var(--accent);
    transform: rotate(-45deg);
  }
  .pair { display: flex; gap: 20px; justify-content: center; }
  .pair .frame { flex: 0 1 260px; }

  .ipad-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    align-items: start;
  }
  .ipad-grid .shot { width: 100%; max-width: 560px; margin: 0 auto; }
  .ipad-grid .shot:not(.wide) { max-width: 360px; }
  .ipad-grid .shot:nth-child(n+5) { grid-column: auto; }

  .duo-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 32px;
    align-items: end;
    max-width: 960px;
    margin: 0 auto;
  }
  .duo-grid .shot:nth-child(2) { max-width: 260px; margin: 0 auto; }
  .fine { text-align: center; color: var(--text-muted); font-size: 0.85rem; margin-top: 20px; }
  .fine.center { max-width: 640px; margin: 28px auto 0; }

  .feature-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .v2-card { padding: 24px; border-top: 2px solid var(--accent); }
  .v2-card h4 { font-size: 1.05rem; margin-bottom: 8px; }
  .v2-card p { color: var(--text-secondary); font-size: 0.95rem; }

  @media (max-width: 900px) {
    .split { grid-template-columns: 1fr; gap: 28px; }
    .split.reverse .split-media { order: 0; }
    .split-text { order: -1; }
    .split.reverse .split-text { order: -1; }
    .block-title.left { text-align: center; }
    .ipad-grid { grid-template-columns: 1fr; }
    .duo-grid { grid-template-columns: 1fr; }
    .feature-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .block { margin-top: 72px; }
    .block-title { font-size: 1.5rem; }
    .container { padding-left: 16px; padding-right: 16px; }
    .feature-grid { grid-template-columns: 1fr; }
    .pair { gap: 12px; }
    .strip { gap: 16px; }
    .strip .shot { flex-basis: 62vw; }
    .strip-center { overflow-x: visible; }
    .strip-center .shot { flex: 0 0 62vw; }
    .strip-center .watch-shot { flex-basis: 40vw; }
    .hd-ipad { width: 70%; transform: none; }
    .hd-phone { width: 34%; }
    .hd-watch { width: 20%; }
    .frame-phone { border-radius: 24px; padding: 4px; }
    .frame-phone img { border-radius: 20px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .strip { scroll-behavior: auto; }
  }
</style>
